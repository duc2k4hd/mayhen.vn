APP_NAME="Mây Hẹn"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

# SEPAY & VIETQR
SEPAY_WEBHOOK_TOKEN=https://mayhen.vn/api/payments/sepay/webhook
SEPAY_BANK_CODE=MB
SEPAY_BANK_NAME="MB Bank"
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
# Hỗ trợ cả SePay API v2 (khuyên dùng: https://userapi.sepay.vn/v2) lẫn v1 legacy (https://my.sepay.vn/userapi)
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
SEPAY_QR_TEMPLATE=compact2


# KHU VỰC GOOGLE OAUTH (Đăng nhập Google OAuth 2.0 + PKCE S256)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"


# KHU VỰC CLOUDFLARE (R2 Object Storage for Wedding Media)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=mayhen-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.mayhen.vn
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# KHU VỰC ĐẦU NÃO AI (9Router API - OpenAI Compatible)
NINEROUTER_ENABLED=true
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=
NINEROUTER_REVIEWER_MODEL=
NINEROUTER_TIMEOUT=20


# AUTONOMOUS INTELLIGENCE ENGINE V2 (Mặc định tắt & budget=0 để bảo vệ hosting)
AI_LEARNING_ENABLED=true
AI_LEARNING_MODE=conservative
AI_LEARNING_MAX_CONCURRENCY=1
AI_LEARNING_MAX_TASKS_PER_CYCLE=2
AI_LEARNING_CYCLE_BUDGET_SECONDS=20
AI_LEARNING_MAX_MEMORY_MB=128
AI_LEARNING_REQUEST_TIMEOUT_SECONDS=10
AI_LEARNING_DAILY_TOKEN_BUDGET=0
AI_LEARNING_DAILY_COST_BUDGET=0
AI_LEARNING_AUTO_PAUSE=true
AI_LEARNING_ADMIN_APPROVAL_REQUIRED=true
AI_LEARNING_EXTERNAL_RETRIEVAL=false
AI_LEARNING_ALLOW_UNVERIFIED_PROMOTION=false


# AUTONOMOUS WEB RESEARCH V3 (Thị trường & Văn hóa cưới Việt Nam)
AI_RESEARCH_EXTERNAL_ENABLED=true
AI_RESEARCH_COUNTRY=VN
AI_RESEARCH_LANGUAGE=vi
AI_RESEARCH_AUTONOMY_LEVEL=supervised
AI_RESEARCH_MAX_URLS_PER_CYCLE=2
AI_RESEARCH_MAX_QUERIES_PER_DISCOVER=3
AI_RESEARCH_FETCH_TIMEOUT_SECONDS=8
AI_RESEARCH_MAX_RESPONSE_BYTES=524288
AI_RESEARCH_DOMAIN_RATE_LIMIT_SECONDS=3
AI_RESEARCH_RECHECK_DAYS=14
AI_SEARCH_API_PROVIDER=
AI_SEARCH_API_KEY=


APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mayhen
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.tino.vn
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=no-reply@mayhen.vn
MAIL_PASSWORD=Ducnobi2004@
MAIL_FROM_ADDRESS="no-reply@mayhen.vn"
MAIL_FROM_NAME="Mây Hẹn"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Viết cho tôi commit Tiếng Việt có dấu mở đầu mang ý nghĩa chính xác (ví dụ: fix(), refactor(),...) để tôi gửi commit, bạn không được phép tự gửi lệnh, viết git chi tiết mức độ vừa, đủ để đọc hiểu


















